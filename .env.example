# 복사해서 .env.local 로 사용하세요 (.env.local 은 git에 올라가지 않아요)
# 백엔드 API 주소 (API 명세 Base URL: /v1)
VITE_API_BASE_URL=http://localhost:8080/v1
# true 면 백엔드 없이 src/mocks 의 가짜 데이터로 화면 개발
VITE_USE_MOCK=true
# 개발용 Bearer 토큰 (명세에 로그인 API 가 아직 없어요)
VITE_ACCESS_TOKEN=
# AI 생성 요청 model_id 기본값 (GET /ai/models 의 id · 비우면 사용 가능한 첫 모델)
VITE_AI_MODEL_ID=
